# ============================================================================
# BI 低代码平台 - Docker Compose 环境变量示例
# ============================================================================
# 使用:
#   1) 复制本文件为 .env.docker
#   2) 填写必填密钥 (不要提交到 Git)
#   3) docker compose --env-file .env.docker up -d --build
#
# 生成密钥:
#   CRYPTO_KEY: openssl rand -hex 32        (必须 64 位 hex)
#   JWT_SECRET: openssl rand -base64 48
# ============================================================================

# ---------- 必填 ----------
# 注意: 密码若包含 @ : / ? # 等 URL 保留字符, 需先做 URL 编码后再写入,
#       否则 DATABASE_URL 解析会失败 (建议使用纯字母数字密码)
MYSQL_ROOT_PASSWORD=change-me-strong-password
JWT_SECRET=change-me-random-secret-at-least-32-chars
CRYPTO_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---------- 访问地址 ----------
# 对外访问地址, 需与浏览器地址栏一致 (用于 CORS 白名单)
CORS_ORIGIN=http://localhost
# 前端宿主机端口
FRONTEND_PORT=80

# ---------- 认证 ----------
# 生产默认关闭注册; 首次部署可通过 seed 管理员账号登录
ALLOW_REGISTRATION=false
# 仅 HTTP 部署时保持 false; 启用 HTTPS 后务必设为 true
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_LOCK_MS=900000

# ---------- 性能 ----------
AUTH_VERSION_TTL_MS=30000
ROLE_PERMISSION_TTL_MS=60000
METADATA_CACHE_TTL_MS=60000
DB_POOL_MAX_POOLS=20

# ---------- 可选 ----------
# 报表 Webhook 签名密钥, 留空则回退使用 CRYPTO_KEY
WEBHOOK_SIGNING_SECRET=
